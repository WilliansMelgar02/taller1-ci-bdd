<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- ================================================================
       Coordenadas del proyecto
       ================================================================ -->
  <groupId>cl.taller.qa</groupId>
  <artifactId>taller1-ci-bdd</artifactId>
  <version>1.1.0</version>
  <packaging>jar</packaging>

  <name>Portal de Clientes - Automatizacion de Pruebas</name>
  <description>
    Portal de Clientes con API HTTP e interfaz web, usado para demostrar integracion continua
    y un deployment pipeline: pruebas unitarias con JUnit 5, pruebas de integracion sobre la
    API, escenarios BDD con Cucumber, pruebas de aceptacion con Selenium y despliegue
    Blue-Green con rollback automatico.
  </description>

  <!-- ================================================================
       Propiedades centralizadas.
       Todas las versiones viven aqui: un solo lugar para actualizar
       dependencias y evitar inconsistencias entre modulos.
       ================================================================ -->
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <junit.version>5.11.4</junit.version>
    <junit.platform.version>1.11.4</junit.platform.version>
    <cucumber.version>7.20.1</cucumber.version>
    <gson.version>2.14.0</gson.version>

    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.jar.version>3.4.2</maven.jar.version>
    <maven.shade.version>3.6.2</maven.shade.version>
    <maven.surefire.version>3.5.2</maven.surefire.version>
    <maven.failsafe.version>3.5.2</maven.failsafe.version>
    <maven.surefire.report.version>3.5.2</maven.surefire.report.version>
    <maven.site.version>3.12.1</maven.site.version>
    <jacoco.version>0.8.12</jacoco.version>

    <!-- Umbrales de cobertura que actuan como quality gate -->
    <cobertura.instrucciones.minima>0.80</cobertura.instrucciones.minima>
    <cobertura.ramas.minima>0.70</cobertura.ramas.minima>
    <cobertura.clase.minima>0.70</cobertura.clase.minima>

    <!-- Permite al pipeline ejecutar solo la etapa BDD sin repetir las unitarias -->
    <skipUnitTests>false</skipUnitTests>
  </properties>

  <!-- ================================================================
       Gestion de dependencias mediante BOM.
       El BOM fija versiones coherentes de toda una familia de artefactos,
       por lo que las dependencias de abajo no declaran <version>.
       ================================================================ -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Gson: serializa el contrato JSON de la API (unica dependencia de produccion) -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>

    <!-- JUnit 5 (Jupiter): motor de las pruebas unitarias atomicas -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- JUnit Platform Suite: permite declarar la clase runner de Cucumber -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <version>${junit.platform.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Cucumber: definicion de pasos en Java para los escenarios Gherkin -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Motor que integra Cucumber con la JUnit Platform (lo ejecuta Failsafe) -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Nombre estable del artefacto: el Dockerfile lo copia sin depender de la version -->
    <finalName>portal-clientes</finalName>

    <plugins>
      <!-- Compilacion con Java 17 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
      </plugin>

      <!-- ============================================================
           EMPAQUETADO = artefacto desplegable.
           El MANIFEST declara la clase principal y la version del proyecto,
           que la aplicacion informa en /health para que el pipeline
           confirme que responde la version recien desplegada.
           ============================================================ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven.jar.version}</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>cl.taller.qa.Aplicacion</mainClass>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Jar autocontenido (incluye Gson): la imagen Docker solo necesita
           'java -jar', sin armar un classpath dentro del contenedor. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.version}</version>
        <executions>
          <execution>
            <id>jar-ejecutable</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <!-- Metadatos de modulos de las dependencias: no aplican a un jar plano -->
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- El MANIFEST valido es el del proyecto; el de Gson se descarta -->
                  <artifact>com.google.*:*</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- Garantiza que el jar final conserve la clase principal y la version -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>cl.taller.qa.Aplicacion</mainClass>
                  <manifestEntries>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ============================================================
           SUREFIRE = pruebas UNITARIAS (rapidas, aisladas, sin I/O).
           Se excluye explicitamente el paquete bdd para garantizar la
           separacion de niveles: 'mvn test' solo corre lo unitario.
           ============================================================ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.version}</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <excludes>
            <exclude>**/bdd/**</exclude>
          </excludes>
          <!-- El pipeline usa -DskipUnitTests=true en la etapa BDD para no repetirlas -->
          <skipTests>${skipUnitTests}</skipTests>
          <!-- La JVM que se lanza para las pruebas debe escribir en UTF-8:
               sin esto, los acentos y la enie de los escenarios en espanol
               salen corruptos en la consola y en los logs del pipeline. -->
          <argLine>@{argLine} -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</argLine>
          <!-- Falla el build ante el primer test roto: politica fail-fast del pipeline -->
          <testFailureIgnore>false</testFailureIgnore>
        </configuration>
      </plugin>

      <!-- ============================================================
           FAILSAFE = pruebas de ACEPTACION / BDD (Cucumber).
           Corren en la fase 'integration-test' con 'mvn verify'.
           ============================================================ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven.failsafe.version}</version>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <!-- La JVM que se lanza para las pruebas debe escribir en UTF-8:
               sin esto, los acentos y la enie de los escenarios en espanol
               salen corruptos en la consola y en los logs del pipeline. -->
          <argLine>@{argLine} -Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</argLine>
        </configuration>
        <executions>
          <execution>
            <id>escenarios-bdd</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>


      <!-- ============================================================
           JACOCO = cobertura de codigo.
           El agente se engancha a la JVM de las pruebas (de ahi el
           @{argLine} en Surefire y Failsafe) y acumula la cobertura de
           ambos niveles en un mismo archivo, por lo que el reporte
           refleja lo que cubren las unitarias MAS los escenarios BDD.

           La cobertura no es un fin en si misma: un 100% no garantiza
           que las pruebas sean buenas. Se usa como red de seguridad
           para detectar codigo de produccion que nadie esta ejercitando.
           ============================================================ -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>preparar-agente</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>reporte-cobertura</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!-- Quality gate: si la cobertura baja del umbral, el build falla
               y el merge queda bloqueado. Un umbral que no rompe el build
               es una sugerencia, no un control. -->
          <execution>
            <id>verificar-umbral-de-cobertura</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <!-- Aplicacion solo ensambla piezas y arranca el proceso: no se
                   ejecuta dentro de las pruebas en memoria. La verifican el
                   health check y las pruebas de aceptacion sobre el contenedor. -->
              <excludes>
                <exclude>cl/taller/qa/Aplicacion.class</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.instrucciones.minima}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.ramas.minima}</minimum>
                    </limit>
                  </limits>
                </rule>
                <!-- Regla por clase: un umbral global se cumple aunque una
                     clase concreta este casi sin cubrir, porque el promedio
                     la esconde. Esta segunda regla obliga a que ninguna
                     clase quede por debajo del minimo. -->
                <rule>
                  <element>CLASS</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.clase.minima}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Genera el sitio/reportes HTML navegables en target/site -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-site-plugin</artifactId>
        <version>${maven.site.version}</version>
      </plugin>
    </plugins>
  </build>

  <!-- ================================================================
       Reporting: 'mvn site' produce el reporte HTML navegable de Surefire
       y Failsafe (resumen, detalle por clase y por caso de prueba).
       ================================================================ -->
  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-report-plugin</artifactId>
        <version>${maven.surefire.report.version}</version>
        <reportSets>
          <reportSet>
            <reports>
              <report>report-only</report>
              <report>failsafe-report-only</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>
</project>
